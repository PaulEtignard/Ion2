# Base Postgres (Prisma Postgres / Neon via le Marketplace Vercel, ou `npx prisma dev` en local)
DATABASE_URL="postgres://..."

# Mot de passe partagé par la team pour se connecter au site
TEAM_PASSWORD="change-moi"

# Secret de signature des sessions (openssl rand -hex 32)
AUTH_SECRET="une-longue-chaine-aleatoire"

# Clé du serveur MCP (en-tête Authorization: Bearer <clé>)
MCP_API_KEY="une-autre-longue-chaine-aleatoire"

# Heure du reset quotidien/hebdo (le mercredi) dans le fuseau indiqué
NEXT_PUBLIC_RESET_HOUR="6"
NEXT_PUBLIC_RESET_TZ="Europe/Paris"
